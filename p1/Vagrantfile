# -*- mode: ruby -*-
# vi: set ft=ruby :

# https://portal.cloud.hashicorp.com/vagrant/discover?query=generic%2Falpine
# Last alpine box I found on Hashicorp cloud
BOX = "generic/alpine318"

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.provider :libvirt


  # First VM, acting as the k3s server (controller mode)
  config.vm.define "guebersoS" do |server|
    server.vm.hostname = "guebersoS"
    server.vm.network "private_network", ip: "192.168.56.110", libvirt__network_name: "vagrant-libvirt"

    server.vm.provider "libvirt" do |lv|
      lv.cpus = 1
      lv.memory = 1024
    end

    server.vm.provision "ansible" do |ansible|
      ansible.playbook = "confs/playbooks/server.yml"
      ansible.verbose = "v"
    end
  end

  # Second VM, acting as the K3s worker (agent mode)
  config.vm.define "guebersoSW" do |worker|
    worker.vm.hostname = "guebersoSW"
    worker.vm.network "private_network", ip: "192.168.56.111", libvirt__network_name: "vagrant-libvirt"

    worker.vm.provider "libvirt" do |lv|
      lv.cpus = 1
      lv.memory = 1024
    end

    worker.vm.provision "ansible" do |ansible|
      worker.playbook = "confs/playbooks/worker.yml"
      ansible.verbose = "v"
    end
  end
end
